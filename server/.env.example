# Default verification provider (millionverifier | neverbounce).
# Missing or invalid values fall back to millionverifier.
DEFAULT_VERIFICATION_PROVIDER=millionverifier

# MillionVerifier API (https://app.millionverifier.com/api)
MILLIONVERIFIER_API_KEY=
MILLIONVERIFIER_API_URL=https://api.millionverifier.com/api/v3/
# Optional: override the bulk API base URL
# MILLIONVERIFIER_BULK_API_URL=https://bulkapi.millionverifier.com/bulkapi/v2/

# NeverBounce API (key starts with "private_" or "secret_")
NEVERBOUNCE_API_KEY=

# Express configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Mock sandbox configuration (used for any provider without a key, or when the UI selects Mock)
MOCK_STARTING_CREDITS=10000

# Bulk verification configuration
MAX_BULK_EMAILS=25000

# Laravel Email Registry API (separate project, e.g. C:/wamp64/www/email-registry-api).
# Checked before every paid verification; new results are saved to it. Server-side only:
# the token is never sent to the browser. Leave both empty to disable the registry.
# http:// is accepted only for localhost / 127.0.0.1; use https:// for any other host.
EMAIL_REGISTRY_API_URL=http://127.0.0.1:8000/api
# Must equal REGISTRY_API_TOKEN in the Laravel project's .env
EMAIL_REGISTRY_API_TOKEN=
# Full request timeout and "no response yet" (connect) timeout, in ms
EMAIL_REGISTRY_TIMEOUT=15000
EMAIL_REGISTRY_CONNECT_TIMEOUT=5000
# Registry unreachable: block = refuse to verify (no paid calls without a lookup; default)
#                       provider = verify anyway, flag the response, save when the registry is back
# Set to false to switch the registry off without removing URL/token
EMAIL_REGISTRY_ENABLED=true
EMAIL_REGISTRY_FALLBACK=block
# Re-verify stored results older than N days (0 = reuse forever)
EMAIL_REGISTRY_MAX_AGE_DAYS=0
# Max saves per minute. Keep below Laravel's API_RATE_LIMIT (default 120 requests/min per IP),
# leaving headroom for lookups. Raise both together for large bulk jobs.
EMAIL_REGISTRY_SAVE_RATE_PER_MINUTE=90

# Bulk Verification Jobs (up to 1,000 leads per import, verified batch by batch).
# Job state is kept in a local SQLite database (Node >= 22.13 built-in) so jobs survive restarts;
# result CSVs are written to a private storage folder and downloaded through the API only.
# Defaults: server/data/bulk-verification.sqlite and server/storage/bulk-files
# BULK_DB_FILE=
# BULK_STORAGE_DIR=
# How many bulk jobs may verify at the same time (batches inside a job always run one by one)
BULK_MAX_CONCURRENT_JOBS=1
# How often (ms) a running batch's progress is checked
BULK_POLL_MS=3000
